{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "create build folder",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "New-Item -ItemType Directory -Force -Path '${workspaceFolder}/build' | Out-Null"
            ],
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "TDM-GCC: build all cpp files",
            "command": "C:/TDM-GCC-64/bin/g++.exe",
            "dependsOn": "create build folder",
            "dependsOrder": "sequence",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "${workspaceFolder}/ChosenHand.cpp",
                "${workspaceFolder}/BlindRule.cpp",
                "${workspaceFolder}/FiveOfAKindChecker.cpp",
                "${workspaceFolder}/FlushChecker.cpp",
                "${workspaceFolder}/FlushFiveChecker.cpp",
                "${workspaceFolder}/FlushHouseChecker.cpp",
                "${workspaceFolder}/FourOfAKindChecker.cpp",
                "${workspaceFolder}/FullHouseChecker.cpp",
                "${workspaceFolder}/GameManager.cpp",
                "${workspaceFolder}/Hand.cpp",
                "${workspaceFolder}/HandGenerator.cpp",
                "${workspaceFolder}/HandPlayer.cpp",
                "${workspaceFolder}/HighCardChecker.cpp",
                "${workspaceFolder}/Main.cpp",
                "${workspaceFolder}/PairChecker.cpp",
                "${workspaceFolder}/PokerHandChecker.cpp",
                "${workspaceFolder}/RewardRule.cpp",
                "${workspaceFolder}/RoyalFlushChecker.cpp",
                "${workspaceFolder}/ScoringRule.cpp",
                "${workspaceFolder}/StraightChecker.cpp",
                "${workspaceFolder}/StraightFlushChecker.cpp",
                "${workspaceFolder}/ThreeOfAKindChecker.cpp",
                "${workspaceFolder}/TwoPairChecker.cpp",
                "-o",
                "${workspaceFolder}/build/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-Command"
                    ]
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds every .cpp file in this project with TDM-GCC."
        },
        {
            "type": "shell",
            "label": "TDM-GCC: run Despat Balatro",
            "dependsOn": "TDM-GCC: build all cpp files",
            "dependsOrder": "sequence",
            "command": "& '${workspaceFolder}/build/main.exe'; Write-Host ''; Read-Host 'Press Enter to close'",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-Command"
                    ]
                }
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Builds the project, then runs build/main.exe."
        }
    ]
}
